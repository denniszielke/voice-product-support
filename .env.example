# Azure AI Foundry project
AZURE_AI_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<project-id>
AZURE_AI_PROJECT_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.MachineLearningServices/workspaces/<project>

# Model deployment
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
AZURE_OPENAI_ENDPOINT=https://<your-account>.openai.azure.com/
OPENAI_API_VERSION=2024-05-01-preview

# Azure Container Registry (for hosted agents)
AZURE_CONTAINER_REGISTRY_ENDPOINT=<registry>.azurecr.io

# Azure AI Search (for product-guide vector search)
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=bike-products
AZURE_SEARCH_API_KEY=

# Bing Custom Search (for support-hotline web research)
BING_CUSTOM_GROUNDING_CONNECTION_NAME=
BING_CUSTOM_GROUNDING_CONFIG_INSTANCE_NAME=default

# Application Insights (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- VoiceLive client (src/voice-invocation/client.py) ---
# VoiceLive endpoint (AI Services / Foundry account)
AZURE_VOICELIVE_ENDPOINT=https://<account>.services.ai.azure.com
# VoiceLive realtime model (custom-backend mode only; default: SDK default)
AZURE_VOICELIVE_MODEL=gpt-realtime

# Hosted-agent mode
AZURE_AI_HOSTED_AGENT_NAME=bike-renting
AZURE_AI_PROJECT_NAME=

# Custom-backend mode: /invocations URL to forward each turn to.
# When set, VoiceLive is used for STT+TTS only and conversational logic
# comes from this endpoint instead of a Foundry hosted agent.
INVOCATION_URL=http://localhost:8088/invocations

# --- Bike-rental MCP server (src/mcp-server-bike-rental/server.py) ---
# Where the MCP server binds.
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000

# --- Voice-Live MCP agent (src/agents/voice-live-mcp/agent.py) ---
# Publicly-reachable URL of the bike-rental MCP server's /mcp endpoint.
# VoiceLive runs in the cloud and must be able to reach this URL --
# use a tunnel (devtunnel / ngrok) when running the server locally.
BIKE_RENTAL_MCP_URL=https://<tunnel-or-public-host>/mcp
# Label sent in MCP events (free-form, used in logs and approval prompts).
BIKE_RENTAL_MCP_LABEL=bike-rental
# MCP approval policy: 'never' (auto-approve all tool calls) or 'always'
# (prompt in the terminal for every call).
BIKE_RENTAL_MCP_REQUIRE_APPROVAL=never
# Optional override for the spoken voice.
AZURE_VOICELIVE_VOICE=en-US-Ava:DragonHDLatestNeural
