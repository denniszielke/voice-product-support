# Azure Speech Services (for STT and TTS)
AZURE_SPEECH_API_KEY=your-speech-api-key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US
AZURE_TTS_VOICE=en-US-AvaMultilingualNeural

# Azure OpenAI (for LLM)
AZURE_OPENAI_API_KEY=your-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8089

# WebRTC TURN server (optional for local dev, required for production)
# WEBRTC_TURN_URL=turn:your-turn-server:3478
# WEBRTC_TURN_USERNAME=your-username
# WEBRTC_TURN_CREDENTIAL=your-credential
# WEBRTC_TURN_STUN_URL=stun:your-turn-server:3478
