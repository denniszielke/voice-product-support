# Azure OpenAI Realtime endpoint
# API key for the Azure OpenAI resource hosting the realtime deployment.
AZURE_REALTIME_API_KEY=

# Full wss:// realtime endpoint including api-version and deployment.
# Example:
# wss://your-resource.openai.azure.com/openai/realtime?api-version=2025-04-01-preview&deployment=gpt-4o-realtime-preview
AZURE_REALTIME_BASE_URL=wss://your-resource.openai.azure.com/openai/realtime?api-version=2025-04-01-preview&deployment=your-realtime-deployment
