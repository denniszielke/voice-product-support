# Voice Live endpoint (your AI Services / Foundry account).
#   Example: https://my-account.services.ai.azure.com
AZURE_VOICELIVE_ENDPOINT=https://<account>.services.ai.azure.com

# Realtime model deployed in the account. Defaults to gpt-realtime.
AZURE_VOICELIVE_MODEL=gpt-realtime

# Voice Live REST API version.
AZURE_VOICELIVE_API_VERSION=2026-01-01-preview

# Azure Standard voice name. Any supported Voice Live voice works.
AZURE_VOICELIVE_VOICE=en-US-Ava:DragonHDLatestNeural

# Bike-renting invocations endpoint to forward each user turn to.
# When running `python src/agents/bike-renting/main.py` locally this is:
INVOCATION_URL=http://localhost:8088/invocations

# Port for this bridge server (browser → http://localhost:8095/)
WEBRTC_BIKE_PORT=8095
